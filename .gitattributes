# Shell scripts, systemd units and Caddy configs are deployed verbatim to the Linux
# VPS via scp — CRLF would corrupt them (bash "syntax error", awk regex with \r,
# systemd Environment values). Force LF regardless of Windows autocrlf.
*.sh text eol=lf
*.service text eol=lf
*.Caddyfile text eol=lf
Caddyfile text eol=lf
