<Window x:Class="ToDo.Views.Dialogs.DbPathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ToDo.Services"
        Title="{x:Static services:Loc.DbPathTitle}" Height="240" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CardBackgroundBrush}"
        FontFamily="{StaticResource FluentFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static services:Loc.DbPathTitle}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Text="{x:Static services:Loc.DbPathPrompt}" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

        <Grid Grid.Row="2" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource FluentTextBox}" FontSize="13"/>
            <Button Grid.Column="1" Content="..." Style="{StaticResource FluentButton}"
                    Width="32" Height="28" Padding="0" Margin="4,0,0,0"
                    Click="Browse_Click"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static services:Loc.Cancel}" Style="{StaticResource FluentButton}"
                    FontSize="13" Padding="16,6" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="{x:Static services:Loc.Save}" Style="{StaticResource FluentAccentButton}"
                    FontSize="13" Padding="16,6" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
