<Window x:Class="ToDo.Views.Dialogs.DateTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ToDo.Services"
        Title="{x:Static services:Loc.PickDate}" Height="220" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="{StaticResource FluentFont}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static services:Loc.PickDate}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ComboBox x:Name="YearCombo" Style="{StaticResource FluentComboBox}" FontSize="14"
                      Width="84" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="MonthCombo" Style="{StaticResource FluentComboBox}" FontSize="14"
                      Width="84" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="DayCombo" Style="{StaticResource FluentComboBox}" FontSize="14"
                      Width="56" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{x:Static services:Loc.Cancel}" Style="{StaticResource FluentButton}"
                    FontSize="14" Padding="16,8" Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="{x:Static services:Loc.Save}" Style="{StaticResource FluentAccentButton}"
                    FontSize="14" Padding="16,8"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
