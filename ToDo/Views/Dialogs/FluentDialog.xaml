<Window x:Class="ToDo.Views.Dialogs.FluentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ToDo.Services;assembly=ToDo.Core"
        Title="{x:Static services:Loc.AppTitle}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundBrush}"
        FontFamily="{StaticResource FluentFont}"
        MinWidth="360" MaxWidth="520">
    <Window.Resources>
        <!-- Destructive action button (delete confirms) -->
        <Style x:Key="FluentDangerButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
            <Setter Property="Background" Value="{DynamicResource AccentRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentRedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A4271A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#8E2215"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconText" Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                       FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,0,0,0"/>
            <TextBlock x:Name="MessageText" Grid.Column="1" FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"
                       VerticalAlignment="Top" Margin="0,3,0,0" LineHeight="20"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Content="{x:Static services:Loc.Cancel}"
                    Style="{StaticResource FluentButton}" FontSize="13" Padding="16,6"
                    Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" Visibility="Collapsed"/>
            <Button x:Name="OkButton" Style="{StaticResource FluentAccentButton}"
                    FontSize="13" Padding="18,6" IsDefault="True" Click="Ok_Click"
                    Visibility="Collapsed"/>
            <Button x:Name="DeleteButton" Style="{StaticResource FluentDangerButton}"
                    FontSize="13" Padding="18,6" IsDefault="True" Click="Ok_Click"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
