<UserControl x:Class="ToDo.Views.DetailPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:ToDo.Models;assembly=ToDo.Core"
             xmlns:services="clr-namespace:ToDo.Services;assembly=ToDo.Core"
             mc:Ignorable="d"
             Focusable="False">

    <!-- Hosted in MainWindow grid spanning the former DetailSplitter + DetailPane columns
         (both Auto). The root's own Auto/Auto columns mirror that split: the splitter stays
         a real 5px strip at the pane's LEFT edge while DetailPane's Width drives the layout. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="DetailSplitter" Grid.Column="0" Width="5" Cursor="SizeWE"
                Background="Transparent" Visibility="Collapsed"
                MouseLeftButtonDown="DetailSplitter_MouseDown"
                MouseMove="DetailSplitter_MouseMove"
                MouseLeftButtonUp="DetailSplitter_MouseUp"/>

        <!-- Width is code-animated (0→saved open / saved→0 close, see UpdateForSelectedTask) so the
             themed task area re-crops smoothly instead of snapping. Content stretches to the
             pane's width (resizable), clipped during the slide so it reveals progressively. -->
        <Border x:Name="DetailPane" Grid.Column="1" Width="0" Visibility="Collapsed"
                ClipToBounds="True"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="20,16" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="{x:Static services:Loc.TaskDetails}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button Content="&#xE89F;" FontFamily="Segoe Fluent Icons"
                                Style="{StaticResource FluentSubtleButton}" FontSize="14"
                                HorizontalAlignment="Right"
                                Click="DetailPane_Close"/>
                    </Grid>
                </Border>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Focusable="False" FocusVisualStyle="{x:Null}">
                    <StackPanel Margin="20,16">
                        <TextBox x:Name="DetailTitleBox"
                                 Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FluentTextBox}" FontSize="18"
                                 FontWeight="SemiBold" BorderThickness="0,0,0,1"
                                 Margin="0,0,0,16"
                                 GotFocus="DetailField_GotFocus"
                                 LostFocus="DetailField_LostFocus"/>

                        <!-- Due Date -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Date}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Button x:Name="DueDateBtn"
                                            Style="{StaticResource FluentSubtleButton}"
                                            FontSize="13" Padding="8,4" HorizontalAlignment="Left"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Click="DueDateBtn_Click">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DueDateLabel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button Content="✕" Style="{StaticResource FluentSubtleButton}"
                                            FontSize="12" Width="24" Height="24" Padding="0"
                                            Foreground="{DynamicResource TextDisabledBrush}"
                                            HorizontalAlignment="Right"
                                            Click="DetailDueDate_Clear"
                                            Visibility="{Binding DueDate, Converter={StaticResource NullToVis}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- My Day toggle -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TextAccentBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{x:Static services:Loc.MyDay}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource FluentCheckBox}"
                                          IsChecked="{Binding IsMyDay, Mode=OneWay}"
                                          Click="MyDayToggle_Click"/>
                            </Grid>
                        </Border>

                        <!-- Reminder -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Reminder}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Button x:Name="ReminderBtn"
                                            Style="{StaticResource FluentSubtleButton}"
                                            FontSize="13" Padding="8,4" HorizontalAlignment="Left"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Click="ReminderBtn_Click">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ReminderLabel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button Content="✕" Style="{StaticResource FluentSubtleButton}"
                                            FontSize="12" Width="24" Height="24" Padding="0"
                                            Foreground="{DynamicResource TextDisabledBrush}"
                                            HorizontalAlignment="Right"
                                            Click="ReminderClear_Click"
                                            Visibility="{Binding Reminder, Converter={StaticResource NullToVis}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Recurrence (ADR-015): pick a rule, or clear it back to one-off. -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Recurrence}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <Button x:Name="RecurrenceBtn"
                                        Style="{StaticResource FluentSubtleButton}"
                                        FontSize="13" Padding="8,4" HorizontalAlignment="Left"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Click="RecurrenceBtn_Click">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RecurrenceLabel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Steps -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Steps}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:TaskStep}">
                                            <Border Margin="0,2" AllowDrop="True"
                                                    DragEnter="StepRow_DragEnter"
                                                    DragOver="StepRow_DragOver"
                                                    DragLeave="StepRow_DragLeave"
                                                    Drop="StepRow_Drop">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource FluentCheckBox}"
                                                          IsChecked="{Binding Completed}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                                          Checked="StepToggle_Changed"
                                                          Unchecked="StepToggle_Changed"/>
                                                <Button Grid.Column="1" HorizontalAlignment="Left"
                                                        Style="{StaticResource FluentSubtleButton}"
                                                        FontSize="13" Padding="0"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"
                                                        Click="StepTitle_Click">
                                                    <Button.Content>
                                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button.Content>
                                                </Button>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13" VerticalAlignment="Center"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                         Style="{StaticResource FluentInlineEditBox}"
                                                         KeyDown="StepEdit_KeyDown"
                                                         LostFocus="StepEdit_LostFocus"/>
                                                <Button Grid.Column="2" Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                                        Style="{StaticResource FluentSubtleButton}" FontSize="14"
                                                        Width="24" Height="24" Padding="0" Cursor="SizeAll"
                                                        Foreground="{DynamicResource TextDisabledBrush}"
                                                        PreviewMouseLeftButtonDown="RecordDragStart"
                                                        MouseMove="StepHandle_MouseMove"
                                                        Click="StepHandle_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="+" FontSize="16"
                                            Style="{StaticResource FluentSubtleButton}"
                                            Foreground="{DynamicResource TextAccentBrush}"
                                            Width="24" Height="28" Padding="0"
                                            VerticalAlignment="Center" Margin="0,0,4,0"
                                            Click="AddStepBox_ButtonClick"/>
                                    <TextBox x:Name="AddStepBox" Grid.Column="1"
                                             Style="{StaticResource FluentTextBox}" FontSize="12"
                                             KeyDown="AddStepBox_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tags Section -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static services:Loc.Tags}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+"
                                            Style="{StaticResource FluentSubtleButton}" FontSize="16"
                                            Width="28" Height="24" Padding="0"
                                            Foreground="{DynamicResource TextAccentBrush}"
                                            Click="DetailAddTag_Click"/>
                                </Grid>
                                <ItemsControl x:Name="DetailTagList" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:Tag}">
                                            <Border Padding="6,3" Margin="0,0,4,4" CornerRadius="10"
                                                    Cursor="Hand"
                                                    Background="{Binding Color, Converter={StaticResource StringToAlphaBrush}}"
                                                    MouseLeftButtonDown="DetailTag_Remove">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"/>
                                                    <TextBlock Text=" ×" FontSize="12"
                                                               Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Group Section (only for custom lists) -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding DataContext.IsCustomList, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock x:Name="DetailGroupLabel" FontSize="11" FontWeight="SemiBold"
                                           Text="{x:Static services:Loc.Group}"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="DetailGroupBox" FontSize="13"
                                          Style="{StaticResource FluentComboBox}"
                                          SelectionChanged="DetailGroup_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComboDisplay}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Close Info -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding CloseRecord, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Closed}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Text="{Binding CloseRecord.CloseMode, Converter={StaticResource CloseModeToIcon}}"
                                               Foreground="{Binding CloseRecord.CloseMode, Converter={StaticResource CloseModeToBrush}}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding CloseModeDisplay}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CloseRecord.ClosedAt, Converter={StaticResource TimestampToRelative}}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Button Content="{x:Static services:Loc.EditCloseTime}"
                                        Style="{StaticResource FluentSubtleButton}" FontSize="12"
                                        HorizontalAlignment="Left" Foreground="{DynamicResource TextAccentBrush}"
                                        Click="DetailPane_EditCloseTime"/>
                            </StackPanel>
                        </Border>

                        <!-- Attachments (local-only, ADR-013) -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                AllowDrop="True" DragOver="AttachmentPanel_DragOver" Drop="AttachmentPanel_Drop">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Static services:Loc.Attachments}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{x:Static services:Loc.AddAttachment}"
                                            Style="{StaticResource FluentSubtleButton}" FontSize="12"
                                            Padding="8,3" Foreground="{DynamicResource TextAccentBrush}"
                                            Click="AddAttachment_Click"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Attachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:TaskAttachment}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE723;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TaskMetaBrush}"/>
                                                <Button Grid.Column="1" HorizontalAlignment="Left"
                                                        Style="{StaticResource FluentSubtleButton}"
                                                        FontSize="13" Padding="0"
                                                        Click="AttachmentOpen_Click">
                                                    <Button.Content>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding SizeDisplay}" FontSize="11"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                                                        </StackPanel>
                                                    </Button.Content>
                                                </Button>
                                                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                        Style="{StaticResource FluentSubtleButton}" FontSize="12"
                                                        Width="24" Height="24" Padding="0"
                                                        Foreground="{DynamicResource TextDisabledBrush}"
                                                        ToolTip="{x:Static services:Loc.Delete}"
                                                        Click="AttachmentRemove_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Static services:Loc.NoAttachments}" FontSize="12"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Attachments.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Notes -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Notes}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <TextBox x:Name="DetailNoteBox"
                                         Text="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource FluentTextBox}" MinHeight="80"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         GotFocus="DetailField_GotFocus"
                                         LostFocus="DetailField_LostFocus"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Padding="20,12" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   Text="{Binding CreatedAt, Converter={StaticResource TimestampToRelative}}"
                                   HorizontalAlignment="Left"/>
                        <Button Content="{x:Static services:Loc.Delete}" Style="{StaticResource FluentSubtleButton}"
                                FontSize="13" Foreground="{DynamicResource AccentRedBrush}"
                                HorizontalAlignment="Right"
                                Click="DetailPane_Delete"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
