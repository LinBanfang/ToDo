<Window x:Class="ToDo.Views.ReminderToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ToDo.Services;assembly=ToDo.Core"
        Title="提醒"
        Width="320" SizeToContent="Height"
        WindowStyle="None" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource FluentFont}">
    <!-- Bottom-right reminder card. Replaces the WinForms tray balloon, which Windows 11
         no longer displays. Drawn with DynamicResource brushes so it follows the theme.
         Height adapts to the content (SizeToContent=Height); Position() re-reads the real
         size after Show(). -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14,12" Cursor="Hand"
            MouseLeftButtonUp="Toast_Click">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Icon = the task's list emoji (same as the sidebar/header); caller supplies it. -->
            <TextBlock x:Name="IconText" Grid.Column="0" Text=""
                       FontFamily="Segoe UI Emoji"
                       FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Static services:Loc.Reminder}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="MessageText" Text="" FontSize="14" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
