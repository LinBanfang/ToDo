<UserControl x:Class="ToDo.Views.TaskListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:ToDo.Models;assembly=ToDo.Core"
             xmlns:vm="clr-namespace:ToDo.ViewModels"
             xmlns:services="clr-namespace:ToDo.Services;assembly=ToDo.Core"
             mc:Ignorable="d"
             Focusable="False">

    <UserControl.Resources>
        <!-- Shared task row inner content -->
        <DataTemplate x:Key="TaskRowContent" DataType="{x:Type models:TaskItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Close status / checkbox -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="18"
                           FontFamily="Segoe MDL2 Assets"
                           Text="{Binding CloseRecord.CloseMode, Converter={StaticResource CloseModeToIcon}}"
                           Foreground="{Binding CloseRecord.CloseMode, Converter={StaticResource CloseModeToBrush}}"
                           Visibility="{Binding CloseRecord, Converter={StaticResource NullToVis}}"/>
                <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Width="22" Height="22"
                        Visibility="{Binding CloseRecord, Converter={StaticResource InverseNullToVis}}"
                        Background="Transparent" BorderBrush="{DynamicResource NeutralGray110}"
                        BorderThickness="1.5" CornerRadius="4" Cursor="Hand"
                        MouseLeftButtonDown="Checkbox_Click"/>
                <!-- Title + meta -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- Show list name during search -->
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextAccentBrush}"
                               Visibility="{Binding DataContext.IsSearching, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ListIdToName}">
                                <Binding Path="ListId"/>
                                <Binding Path="DataContext.Lists" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding Title}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"
                               Visibility="{Binding IsEditingTitle, Converter={StaticResource InverseBoolToVis}}"
                               MouseLeftButtonDown="TaskTitle_DoubleClick">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CloseRecord}" Value="{x:Null}"/>
                                    <DataTrigger Binding="{Binding CloseRecord.CloseMode}" Value="Complete">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CloseRecord.CloseMode}" Value="Cancel">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Style="{StaticResource FluentInlineEditBox}"
                             Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVis}}"
                             IsVisibleChanged="TaskTitleEdit_IsVisibleChanged"
                             KeyDown="TaskTitleEdit_KeyDown"
                             LostFocus="TaskTitleEdit_LostFocus"/>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                        <!-- Tags -->
                        <ItemsControl>
                            <ItemsControl.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </ItemsControl.Visibility>
                            <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{StaticResource TagIdsToTags}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="DataContext.Tags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Tag}">
                                    <Border Padding="6,3" Margin="2,0" CornerRadius="10"
                                            Background="{Binding Color, Converter={StaticResource StringToAlphaBrush}}">
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- My Day sun: between tags and steps while the task is in My Day -->
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextAccentBrush}"
                                   Visibility="{Binding IsMyDay, Converter={StaticResource BoolToVis}}"/>
                        <!-- Gap after tags / My Day sun: no "·" — the tag pills self-delimit.
                             Visibility still depends on a leading item and a later item, so the
                             gap only appears between meta items, never at the line start. -->
                        <TextBlock Text="" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource MetaSep}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DueDate"/>
                                    <Binding Path="Reminder"/>
                                    <Binding Path="Note"/>
                                    <Binding Path="AttachmentCount"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskAttachments" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="IsMyDay"/>
                                    <MultiBinding.ConverterParameter>1</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- Steps progress -->
                        <TextBlock FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TaskMetaBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                            <Run Text="{Binding CompletedStepCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Steps.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- · steps → due date -->
                        <TextBlock Text="·" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource MetaSep}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DueDate"/>
                                    <Binding Path="Reminder"/>
                                    <Binding Path="Note"/>
                                    <Binding Path="AttachmentCount"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskAttachments" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <MultiBinding.ConverterParameter>2</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- Due date: 📅 + text -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="DueDate"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{Binding DueDate, Converter={StaticResource DueDateToBrush}}"/>
                            <TextBlock Text="{Binding DueDate, Converter={StaticResource DueDateToString}}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding DueDate, Converter={StaticResource DueDateToBrush}}"/>
                        </StackPanel>
                        <!-- · due date → reminder -->
                        <TextBlock Text="·" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource MetaSep}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DueDate"/>
                                    <Binding Path="Reminder"/>
                                    <Binding Path="Note"/>
                                    <Binding Path="AttachmentCount"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskAttachments" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <MultiBinding.ConverterParameter>3</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- Reminder: 🔔 + text -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="Reminder"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <MultiBinding.ConverterParameter>future</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{DynamicResource TaskMetaBrush}"/>
                            <TextBlock Text="{Binding Reminder, Converter={StaticResource ReminderToString}}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TaskMetaBrush}"/>
                        </StackPanel>
                        <!-- · reminder → note -->
                        <TextBlock Text="·" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource MetaSep}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DueDate"/>
                                    <Binding Path="Reminder"/>
                                    <Binding Path="Note"/>
                                    <Binding Path="AttachmentCount"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskAttachments" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <MultiBinding.ConverterParameter>4</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- Note icon: single icon, content only in the tooltip -->
                        <TextBlock Text="&#xE932;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TaskMetaBrush}"
                                   ToolTip="{Binding Note}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="Note"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- · note → attachment -->
                        <TextBlock Text="·" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource MetaSep}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DueDate"/>
                                    <Binding Path="Reminder"/>
                                    <Binding Path="Note"/>
                                    <Binding Path="AttachmentCount"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskAttachments" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <MultiBinding.ConverterParameter>5</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- Attachment (paperclip) icon: shows when the task has attachments -->
                        <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TaskMetaBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="AttachmentCount"/>
                                    <Binding Path="DataContext.ShowTaskAttachments" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
                <!-- Right icons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Star_Click" Width="24" Height="24">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE734;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                            <Setter Property="Text" Value="&#xE735;"/>
                                            <Setter Property="Foreground" Value="#FFD335"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Task row wrapper with drag-drop + context menu -->
        <DataTemplate x:Key="TaskRowReorder">
            <Border Style="{StaticResource TaskRowStyle}"
                    PreviewMouseLeftButtonDown="RecordDragStart"
                    MouseLeftButtonDown="TaskRow_Click"
                    MouseMove="TaskRow_MouseMove"
                    ContextMenuOpening="TaskRow_ContextMenuOpening"
                    AllowDrop="True" DragEnter="TaskRow_DragEnter"
                    DragOver="TaskRow_DragOver"
                    DragLeave="TaskRow_DragLeave" Drop="TaskRow_Drop">
                <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskRowContent}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Main content: list header + task area + add-task footer. Hidden in settings mode
         (the settings overlay covers Column 2). -->
    <Grid Visibility="{Binding IsSettingsMode, Converter={StaticResource InverseBoolToVis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- List header -->
        <Border Grid.Row="0" Padding="24,20,24,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Header icon: emoji (list) or search icon, clickable for custom lists -->
                    <Button x:Name="EmojiBtn" Cursor="Hand" Click="ListEmoji_Click"
                            VerticalAlignment="Center" Margin="0,-2,12,0">
                        <Button.Template>
                            <!-- Left-align the emoji like the system-list icon; the button
                                 sizes to its content so there is no centering gap -->
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FluentSubtleButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <!-- Only show for custom lists and not searching -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCustomList}" Value="True"/>
                                            <Condition Binding="{Binding IsSearching}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Content>
                            <TextBlock Text="{Binding ActiveList.Icon}" FontSize="26"
                                       FontFamily="Segoe UI Emoji"
                                       Style="{StaticResource HeaderAdaptiveText}"/>
                        </Button.Content>
                    </Button>
                    <!-- Read-only icon: system list or searching -->
                    <TextBlock VerticalAlignment="Center" Margin="0,-2,12,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <!-- Searching → show search icon -->
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="&#xE721;"/>
                                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                        <Setter Property="FontSize" Value="22"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
                                    </DataTrigger>
                                    <!-- System list, not searching → show emoji -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSystemList}" Value="True"/>
                                            <Condition Binding="{Binding IsSearching}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="Text" Value="{Binding ActiveList.Icon}"/>
                                        <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
                                        <Setter Property="FontSize" Value="26"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </MultiDataTrigger>
                                    <!-- Foreground follows the list theme's title color
                                         (white/dark), same as the title; no-op for color
                                         emoji, applies to monochrome icon glyphs -->
                                    <DataTrigger Binding="{Binding HeaderTitleLight}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HeaderTitleLight}" Value="False">
                                        <Setter Property="Foreground" Value="#201F1E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Editable title (click to rename). The header now sits on the
                         per-list theme background (ADR-014), so the title text flips
                         light/dark for contrast (HeaderTitleLight); null = no theme →
                         the app theme's normal text color. -->
                    <TextBlock x:Name="ListTitleLabel" Text="{Binding HeaderTitle}" FontSize="28"
                               FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                               Style="{StaticResource HeaderAdaptiveText}"
                               MouseLeftButtonDown="ListTitle_Click"/>
                    <TextBox x:Name="ListTitleEdit" FontSize="28" FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalAlignment="Center" Visibility="Collapsed"
                             Style="{StaticResource FluentInlineEditBox}" MinWidth="100"
                             KeyDown="ListTitleEdit_KeyDown"
                             LostFocus="ListTitleEdit_LostFocus"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="NewGroupBtn" Content="{x:Static services:Loc.NewGroup}"
                            FontSize="13" Click="NewGroup_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HeaderAdaptiveButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource HeaderAdaptiveIcon}" FontSize="16"
                            Click="ListMore_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static services:Loc.RenameList}" Click="ListMenu_Rename"/>
                                <MenuItem Header="{x:Static services:Loc.ListTheme}" Click="ListMenu_Theme"/>
                                <MenuItem Header="{x:Static services:Loc.DeleteList}" Click="ListMenu_Delete"
                                          Visibility="{Binding ActiveList.IsSystem, Converter={StaticResource InverseBoolToVis}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Task area -->
        <ScrollViewer x:Name="TaskAreaScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,15,0,8"
                      AllowDrop="True" PreviewDragOver="TaskArea_PreviewDragOver"
                      ScrollChanged="TaskAreaScroll_ScrollChanged">
            <StackPanel x:Name="TaskAreaPanel">
                <!-- ═══ CUSTOM LIST: Groups (first entry = ungrouped tasks) ═══ -->
                <ItemsControl x:Name="GroupedTasksControl" ItemsSource="{Binding GroupedTaskList}"
                              Visibility="{Binding IsCustomList, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GroupedTasks}">
                            <!-- Wrapper border: drop target for entire section -->
                            <Border AllowDrop="True"
                                    DragEnter="GroupSection_DragEnter"
                                    DragLeave="GroupSection_DragLeave"
                                    Drop="GroupSection_Drop"
                                    Padding="0" Background="Transparent" CornerRadius="6">
                            <StackPanel>
                                <!-- Group header (only for real groups). Tag anchors the
                                     visual-tree search that locates the "ungrouped zone"
                                     boundary for the drop slot (FindUngroupedZoneBottom). -->
                                <Border Style="{StaticResource GroupHeaderStyle}" Cursor="Hand"
                                        Tag="TaskGroupHeader"
                                        Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}"
                                        PreviewMouseLeftButtonDown="RecordDragStart"
                                        PreviewMouseMove="GroupHeader_PreviewMouseMove"
                                        MouseLeftButtonUp="GroupHeader_Toggle"
                                        ContextMenuOpening="GroupHeader_ContextMenuOpening"
                                        AllowDrop="True" DragEnter="GroupHeader_DragEnter"
                                        DragOver="GroupHeader_DragOver"
                                        DragLeave="GroupHeader_DragLeave" Drop="GroupHeader_Drop">
                                    <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Group.Collapsed}" Value="True">
                                                            <Setter Property="Text" Value="&#xE76C;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Group name with the task count inline, e.g. "工作 (5)" -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding Group.Name}" FontSize="15"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Tag="GroupName"
                                                       MouseLeftButtonDown="GroupName_DoubleClick"/>
                                            <TextBlock Text="{Binding Tasks.Count, StringFormat='({0})'}"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Margin="6,1,0,0"
                                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="15" FontWeight="SemiBold"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource FluentInlineEditBox}"
                                                 KeyDown="GroupNameEdit_KeyDown"
                                                 LostFocus="GroupNameEdit_LostFocus"/>
                                    </Grid>
                                </Border>
                                <!-- Tasks (hidden if collapsed; always show for ungrouped) -->
                                <ItemsControl ItemsSource="{Binding Tasks}"
                                              Visibility="{Binding TaskListVisible, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:TaskItem}">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskRowReorder}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Empty ungrouped section: zero height with no tasks, so
                                     while a task drag nears the top of the list this slot
                                     expands to accept a grouped task dragged back to ungrouped
                                     (drops bubble to GroupSection_Drop). It only appears when
                                     the pointer is in the top zone (above the first group's
                                     mid) and slides/fades in rather than popping. Height,
                                     Opacity and Margin are animated from code-behind
                                     (TaskListControl.SetDropSlotOpen) — a Style trigger's
                                     EnterActions storyboard is not reverted when the trigger
                                     deactivates, leaving the slot stuck open. The Tag anchors
                                     that visual-tree lookup; the base setters are the closed
                                     state. -->
                                <Border Tag="UngroupDropSlot" Padding="12,8" CornerRadius="8"
                                        ClipToBounds="True"
                                        BorderBrush="{DynamicResource NeutralGray110}"
                                        BorderThickness="1" Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="0"/>
                                            <Setter Property="Opacity" Value="0"/>
                                            <Setter Property="Margin" Value="32,0"/>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{x:Static services:Loc.DropToUngroupHint}"
                                               FontSize="13" Foreground="{DynamicResource TextDisabledBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                        </StackPanel>
                            </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                <!-- ═══ SYSTEM LIST: Flat task list ═══ -->
                <ItemsControl ItemsSource="{Binding ActiveTasks}"
                              Visibility="{Binding IsSystemList, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:TaskItem}">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskRowReorder}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Completed tasks (collapsible; expanded by default) -->
                <Border Visibility="{Binding CompletedTasks.Count, Converter={StaticResource CountToVis}}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                        Margin="0,16,0,0" Padding="0,12,0,0">
                    <StackPanel>
                        <ToggleButton x:Name="CompletedToggle" IsChecked="True"
                                      Focusable="False" Cursor="Hand" HorizontalAlignment="Stretch"
                                      Margin="0,0,0,8">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="Chevron" Text="&#xE70D;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDisabledBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CompletedHeader}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background"
                                                    Value="{DynamicResource TaskCardHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ItemsControl ItemsSource="{Binding CompletedTasks}"
                                      Visibility="{Binding IsChecked, ElementName=CompletedToggle,
                                                           Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TaskItem}">
                                    <Border Style="{StaticResource TaskRowStyle}" Opacity="0.7"
                                            MouseLeftButtonDown="TaskRow_Click"
                                            ContextMenuOpening="TaskRow_ContextMenuOpening">
                                        <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                                        <ContentControl Content="{Binding}"
                                                        ContentTemplate="{StaticResource TaskRowContent}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed Add Task Input at bottom -->
        <Border x:Name="AddTaskFooter" Grid.Row="2" Padding="32,8,32,12"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBox x:Name="AddTaskBox"
                         Style="{StaticResource FluentTextBox}"
                         FontSize="15" Height="47" VerticalContentAlignment="Center"
                         Padding="43,4,6,4"
                         Background="{DynamicResource TaskCardBrush}"
                         KeyDown="AddTaskBox_KeyDown"
                         GotFocus="AddTaskBox_GotFocus"
                         LostFocus="AddTaskBox_LostFocus"
                         TextChanged="AddTaskBox_TextChanged"/>
                <!-- Empty checkbox (same look/position as task rows), shown while the box has focus -->
                <Border x:Name="AddTaskCheckbox" Width="22" Height="22"
                        Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="{DynamicResource NeutralGray110}"
                        BorderThickness="1.5" CornerRadius="4"
                        IsHitTestVisible="False" Visibility="Collapsed"/>
                <!-- Placeholder "+ 添加任务": only when empty and not focused. "+" sits in the
                     checkbox slot, text starts where typed text lands -->
                <Grid x:Name="AddTaskPlaceholder" IsHitTestVisible="False"
                      VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="+" FontSize="22" FontWeight="Light"
                               Foreground="{DynamicResource TextAccentBrush}"
                               Width="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{x:Static services:Loc.AddTask}" FontSize="15"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
