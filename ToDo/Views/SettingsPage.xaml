<UserControl x:Class="ToDo.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ToDo.ViewModels"
             xmlns:services="clr-namespace:ToDo.Services;assembly=ToDo.Core"
             Loaded="SettingsPage_Loaded">
    <UserControl.Resources>
        <!-- Section title: 与左侧导航一一对应的锚点标题（18px 主文字色，明显高于 15px 内容标签） -->
        <Style x:Key="SettingSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SettingSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>

        <!-- ═════ 常规 ═════ -->
        <DataTemplate DataType="{x:Type vm:GeneralSection}">
            <StackPanel Margin="0,4">
                <TextBlock Style="{StaticResource SettingSectionTitle}" Text="{Binding Title}"/>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>
                <TextBlock Style="{StaticResource SettingSectionHeader}" Text="{x:Static services:Loc.LanguageName}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Style="{StaticResource FluentComboBox}" Width="150"
                              SelectedValue="{Binding Language}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="中文" Tag="Chinese"/>
                        <ComboBoxItem Content="English" Tag="English"/>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Style="{StaticResource SettingHint}" Text="{Binding LanguageHint}"/>
                </Grid>
                <Button Content="{x:Static services:Loc.ManageTags}" Style="{StaticResource FluentButton}"
                        Click="ManageTags_Click"
                        AutomationProperties.AutomationId="ManageTags"
                        Padding="14,6" HorizontalAlignment="Left" Margin="0,20,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- ═════ 外观 ═════ -->
        <DataTemplate DataType="{x:Type vm:AppearanceSection}">
            <StackPanel Margin="0,4">
                <TextBlock Style="{StaticResource SettingSectionTitle}" Text="{Binding Title}"/>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>
                <TextBlock Style="{StaticResource SettingSectionHeader}" Text="{x:Static services:Loc.Theme}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Style="{StaticResource FluentComboBox}" Width="150"
                              SelectedValue="{Binding Theme}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{x:Static services:Loc.LightTheme}" Tag="Light"/>
                        <ComboBoxItem Content="{x:Static services:Loc.DarkTheme}" Tag="Dark"/>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Style="{StaticResource SettingHint}"
                               Text="{x:Static services:Loc.AppliesImmediately}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- ═════ 数据 ═════ -->
        <DataTemplate DataType="{x:Type vm:DataSection}">
            <StackPanel Margin="0,4">
                <TextBlock Style="{StaticResource SettingSectionTitle}" Text="{Binding Title}"/>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>
                <TextBlock Style="{StaticResource SettingSectionHeader}" Text="{x:Static services:Loc.DbPathTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               Text="{Binding DbPath}"/>
                    <Button Grid.Column="1" Content="{x:Static services:Loc.Change}" Style="{StaticResource FluentButton}"
                            Command="{Binding ChangeDbPathCommand}" Padding="14,6" Margin="12,0,0,0"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="{x:Static services:Loc.ExportBackup}" Style="{StaticResource FluentButton}"
                            Command="{Binding ExportBackupCommand}" Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="{x:Static services:Loc.RestoreBackup}" Style="{StaticResource FluentButton}"
                            Command="{Binding RestoreBackupCommand}" Padding="14,6"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ═════ 同步 ═════ -->
        <DataTemplate DataType="{x:Type vm:SyncSection}">
            <StackPanel Margin="0,4">
                <TextBlock Style="{StaticResource SettingSectionTitle}" Text="{Binding Title}"/>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>
                <CheckBox Style="{StaticResource FluentCheckBox}" Content="{x:Static services:Loc.SyncEnabledLabel}"
                          IsChecked="{Binding SyncEnabled}"/>
                <TextBlock Style="{StaticResource SettingSectionHeader}" Margin="0,20,0,8"
                           Text="{x:Static services:Loc.SyncServerUrlLabel}"/>
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding SyncServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource SettingSectionHeader}" Margin="0,16,0,8"
                           Text="{x:Static services:Loc.SyncKeyLabel}"/>
                <TextBox Style="{StaticResource FluentTextBox}"
                         Text="{Binding SyncKey, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource SettingSectionHeader}" Margin="0,16,0,8"
                           Text="{x:Static services:Loc.SyncDeviceId}"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding DeviceId}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource SettingSectionHeader}" Margin="0,20,0,8"
                           Text="{x:Static services:Loc.SyncStatusLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="13" VerticalAlignment="Center"
                               Foreground="{Binding StatusBrush}" Text="{Binding StatusText}"/>
                    <TextBlock FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDisabledBrush}" Margin="12,0,0,0"
                               Text="{Binding LastSyncText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="{x:Static services:Loc.SyncNow}" Style="{StaticResource FluentAccentButton}"
                            Command="{Binding SyncNowCommand}" Padding="14,6"
                            AutomationProperties.AutomationId="SyncNow"/>
                </StackPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"
                           Margin="0,20,0,0" TextWrapping="Wrap"
                           Text="{x:Static services:Loc.SyncMyDayLocalHint}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ═════ 更新 ═════ -->
        <DataTemplate DataType="{x:Type vm:UpdateSection}">
            <StackPanel Margin="0,4">
                <TextBlock Style="{StaticResource SettingSectionTitle}" Text="{Binding Title}"/>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>
                <CheckBox Style="{StaticResource FluentCheckBox}" Content="{x:Static services:Loc.CheckForUpdatesOnStartup}"
                          IsChecked="{Binding CheckForUpdatesOnStartup}"/>
                <TextBlock Style="{StaticResource SettingSectionHeader}" Margin="0,20,0,8"
                           Text="{x:Static services:Loc.UpdateSources}"/>
                <ItemsControl ItemsSource="{Binding UpdateSources}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UpdateSourceRow}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Style="{StaticResource FluentComboBox}" Width="110"
                                          SelectedValue="{Binding Type}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="GitHub" Tag="github"/>
                                    <ComboBoxItem Content="Gitee" Tag="gitee"/>
                                    <ComboBoxItem Content="Appcast" Tag="appcast"/>
                                </ComboBox>
                                <TextBox Grid.Column="1" Style="{StaticResource FluentTextBox}"
                                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="8,0"/>
                                <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                        Style="{StaticResource FluentSubtleButton}" FontSize="14" Padding="8,6"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        ToolTip="{x:Static services:Loc.RemoveSource}"
                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{x:Static services:Loc.AddSource}" Style="{StaticResource FluentButton}"
                            Command="{Binding AddSourceCommand}" Padding="14,6" Margin="0,0,8,0"/>
                    <Button Content="{x:Static services:Loc.CheckUpdatesNow}" Style="{StaticResource FluentAccentButton}"
                            Command="{Binding CheckNowCommand}" Padding="14,6"
                            AutomationProperties.AutomationId="CheckUpdatesNow"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ═════ 提醒 ═════ -->
        <DataTemplate DataType="{x:Type vm:ReminderSection}">
            <StackPanel Margin="0,4">
                <TextBlock Style="{StaticResource SettingSectionTitle}" Text="{Binding Title}"/>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>
                <CheckBox Style="{StaticResource FluentCheckBox}" Content="{x:Static services:Loc.EnableReminderNotifications}"
                          IsChecked="{Binding ReminderNotifications}" Margin="0,0,0,10"/>
                <CheckBox Style="{StaticResource FluentCheckBox}" Content="{x:Static services:Loc.PlayReminderSound}"
                          IsChecked="{Binding ReminderSound}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ═════ 行为 ═════ -->
        <DataTemplate DataType="{x:Type vm:BehaviorSection}">
            <StackPanel Margin="0,4">
                <TextBlock Style="{StaticResource SettingSectionTitle}" Text="{Binding Title}"/>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>
                <CheckBox Style="{StaticResource FluentCheckBox}" Content="{x:Static services:Loc.MinimizeToTrayOnClose}"
                          IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,0,0,10"/>
                <CheckBox Style="{StaticResource FluentCheckBox}" Content="{x:Static services:Loc.StickyShowTags}"
                          IsChecked="{Binding StickyShowTags}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ═════ 关于 ═════ -->
        <DataTemplate DataType="{x:Type vm:AboutSection}">
            <StackPanel Margin="0,4">
                <TextBlock Style="{StaticResource SettingSectionTitle}" Text="{Binding Title}"/>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>

                <!-- 图标 + 名称 / 版本 / 简介 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Image Source="{Binding Icon}" Width="48" Height="48"
                           Margin="0,0,16,0" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="To Do" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"
                                   Margin="0,2,0,0" Text="{Binding VersionText}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{x:Static services:Loc.AppDescription}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 项目主页 -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static services:Loc.Homepage}"
                               FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock FontSize="12">
                            <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"
                                       NavigateUri="{Binding GitHubUrl}"
                                       AutomationProperties.AutomationId="AboutGithub">GitHub</Hyperlink>
                        </TextBlock>
                        <TextBlock FontSize="12" Margin="16,0,0,0">
                            <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"
                                       NavigateUri="{Binding GiteeUrl}"
                                       AutomationProperties.AutomationId="AboutGitee">Gitee</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 第三方组件许可 -->
                <TextBlock Text="{x:Static services:Loc.ThirdPartyLicenses}" FontSize="12"
                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,4"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="AutoUpdater.NET · LiteDB · CommunityToolkit.Mvvm · Microsoft.Xaml.Behaviors.Wpf (MIT)"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                           Margin="0,16,0,0" Text="{Binding Copyright}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nav -->
        <ListBox Grid.Column="0" x:Name="SettingsNav" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                 BorderThickness="0" Background="Transparent"
                 FocusVisualStyle="{x:Null}"
                 SelectionChanged="Nav_SelectionChanged"
                 PreviewMouseLeftButtonUp="Nav_PreviewMouseLeftButtonUp"
                 AutomationProperties.AutomationId="SettingsNav">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarNavItem}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SettingsSection}">
                    <TextBlock Text="{Binding Title}" FontSize="14"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Right content: all sections stacked in one scrollable page; clicking the nav
             scrolls to a section and scrolling updates the nav highlight (scrollspy).
             Non-focusable so clicking blank space doesn't grab focus and paint the
             default dashed focus rectangle over the whole region. -->
        <ScrollViewer Grid.Column="1" x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto"
                      Focusable="False" FocusVisualStyle="{x:Null}"
                      ScrollChanged="ScrollViewer_ScrollChanged">
            <ItemsControl x:Name="SectionsPanel" ItemsSource="{Binding Sections}"
                          Margin="0,4,16,0" Focusable="False" FocusVisualStyle="{x:Null}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,0,24"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
