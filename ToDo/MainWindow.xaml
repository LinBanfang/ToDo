<Window x:Class="ToDo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ToDo.Models;assembly=ToDo.Core"
        xmlns:vm="clr-namespace:ToDo.ViewModels"
        xmlns:services="clr-namespace:ToDo.Services;assembly=ToDo.Core"
        xmlns:views="clr-namespace:ToDo.Views"
        mc:Ignorable="d"
        Title="{x:Static services:Loc.AppTitle}"
        Height="720" Width="1200"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource FluentFont}">


    <!-- ═══ MAIN 3-COLUMN LAYOUT ═══ -->
    <Grid PreviewMouseLeftButtonDown="MainWindow_PreviewMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" MinWidth="180" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SIDEBAR (Column 0) ═══════════════ -->
        <views:SidebarControl x:Name="SidebarControl" Grid.Column="0"/>

        <!-- GridSplitter: resize the sidebar, width persisted via SidebarWidth. Painted with
             the content area's base color so the 4-5px hit area doesn't show the window color
             behind it. -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="{DynamicResource AppBackgroundBrush}"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ShowsPreview="True"/>

        <!-- Per-list background theme (ADR-014). Two layers spanning the splitter + content
             + detail-splitter columns (header + task area + footer), so the theme reaches the
             sidebar's right edge and the detail pane's left edge with no color strip in
             between. When there is no theme ListBackgroundBrush is null → transparent → the
             splitters' AppBackgroundBrush and the window background show through. Not
             hit-testable so the splitters stay draggable; hidden in settings mode like the
             content column. The header title stays readable because its text color adapts to
             the background (HeaderTitleLight). -->
        <Grid Grid.Column="1" Grid.ColumnSpan="3"
              Visibility="{Binding IsSettingsMode, Converter={StaticResource InverseBoolToVis}}"
              IsHitTestVisible="False">
            <Border Background="{Binding ListBackgroundBrush}"/>
            <Border Background="{DynamicResource ListBackgroundMaskBrush}"
                    Visibility="{Binding ListBackgroundMaskVisible, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ══════════════ MAIN CONTENT (Column 2) ══════════════ -->
        <views:TaskListControl x:Name="TaskListControl" Grid.Column="2"/>
        <!-- ═══════════════ SETTINGS PAGE (Column 2 overlay) ═══════════════ -->
        <Grid Grid.Column="2" Visibility="{Binding IsSettingsMode, Converter={StaticResource BoolToVis}}"
              AutomationProperties.AutomationId="SettingsHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="20,12,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource FluentSubtleButton}" FontSize="18"
                        Padding="8,6" Command="{Binding CloseSettingsCommand}"
                        AutomationProperties.AutomationId="CloseSettings"
                        AutomationProperties.Name="{x:Static services:Loc.Back}"
                        ToolTip="{x:Static services:Loc.Back}"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Static services:Loc.Settings}" FontSize="22"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
            <views:SettingsPage Grid.Row="1" DataContext="{Binding Settings}"/>
        </Grid>

        <!-- ══════════════ TASK DETAIL PANE ══════════════ -->
        <views:DetailPaneControl x:Name="DetailPaneControl" Grid.Column="3" Grid.ColumnSpan="2"/>

        <!-- Undo bar: bottom-center floating card for 完成/删除 undo. Rendered last so it
             sits above everything; visibility bound to CurrentUndo via the existing NullToVis
             converter. The 5s auto-dismiss DispatcherTimer lives in MainWindow code-behind
             (the VM only exposes the single slot + UndoCommand, keeping it unit-testable). -->
        <Border x:Name="UndoBar"
                Grid.Column="0" Grid.ColumnSpan="5"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Visibility="{Binding CurrentUndo, Converter={StaticResource NullToVis}}"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,10"
                RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="UndoBarTranslate" Y="24"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentUndo.Message}"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,16,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                <Button Grid.Column="1" Content="{x:Static services:Loc.Undo}"
                        Style="{StaticResource FluentAccentButton}" Padding="12,6"
                        Command="{Binding UndoCommand}"
                        AutomationProperties.AutomationId="UndoButton"/>
            </Grid>
        </Border>
    </Grid>
</Window>
