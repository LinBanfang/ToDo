<Window x:Class="ToDo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ToDo.Models;assembly=ToDo.Core"
        xmlns:vm="clr-namespace:ToDo.ViewModels"
        xmlns:services="clr-namespace:ToDo.Services;assembly=ToDo.Core"
        xmlns:views="clr-namespace:ToDo.Views"
        mc:Ignorable="d"
        Title="{x:Static services:Loc.AppTitle}"
        Height="720" Width="1200"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource FluentFont}">

    <Window.Resources>
        <!-- Shared task row inner content -->
        <DataTemplate x:Key="TaskRowContent" DataType="{x:Type models:TaskItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Close status / checkbox -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="18"
                           FontFamily="Segoe MDL2 Assets"
                           Text="{Binding CloseRecord.CloseMode, Converter={StaticResource CloseModeToIcon}}"
                           Foreground="{Binding CloseRecord.CloseMode, Converter={StaticResource CloseModeToBrush}}"
                           Visibility="{Binding CloseRecord, Converter={StaticResource NullToVis}}"/>
                <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0" Width="22" Height="22"
                        Visibility="{Binding CloseRecord, Converter={StaticResource InverseNullToVis}}"
                        Background="Transparent" BorderBrush="{DynamicResource NeutralGray110}"
                        BorderThickness="1.5" CornerRadius="4" Cursor="Hand"
                        MouseLeftButtonDown="Checkbox_Click"/>
                <!-- Title + meta -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- Show list name during search -->
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextAccentBrush}"
                               Visibility="{Binding DataContext.IsSearching, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource ListIdToName}">
                                <Binding Path="ListId"/>
                                <Binding Path="DataContext.Lists" RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding Title}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"
                               Visibility="{Binding IsEditingTitle, Converter={StaticResource InverseBoolToVis}}"
                               MouseLeftButtonDown="TaskTitle_DoubleClick">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CloseRecord}" Value="{x:Null}"/>
                                    <DataTrigger Binding="{Binding CloseRecord.CloseMode}" Value="Complete">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CloseRecord.CloseMode}" Value="Cancel">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15" Style="{StaticResource FluentInlineEditBox}"
                             Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVis}}"
                             IsVisibleChanged="TaskTitleEdit_IsVisibleChanged"
                             KeyDown="TaskTitleEdit_KeyDown"
                             LostFocus="TaskTitleEdit_LostFocus"/>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                        <!-- Tags -->
                        <ItemsControl>
                            <ItemsControl.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </ItemsControl.Visibility>
                            <ItemsControl.ItemsSource>
                                <MultiBinding Converter="{StaticResource TagIdsToTags}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="DataContext.Tags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Tag}">
                                    <Border Padding="6,3" Margin="2,0" CornerRadius="10"
                                            Background="{Binding Color, Converter={StaticResource StringToAlphaBrush}}">
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- My Day sun: between tags and steps while the task is in My Day -->
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextAccentBrush}"
                                   Visibility="{Binding IsMyDay, Converter={StaticResource BoolToVis}}"/>
                        <!-- Gap after tags / My Day sun: no "·" — the tag pills self-delimit.
                             Visibility still depends on a leading item and a later item, so the
                             gap only appears between meta items, never at the line start. -->
                        <TextBlock Text="" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource MetaSep}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DueDate"/>
                                    <Binding Path="Reminder"/>
                                    <Binding Path="Note"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="IsMyDay"/>
                                    <MultiBinding.ConverterParameter>1</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- Steps progress -->
                        <TextBlock FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TaskMetaBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                            <Run Text="{Binding CompletedStepCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Steps.Count, Mode=OneWay}"/>
                        </TextBlock>
                        <!-- · steps → due date -->
                        <TextBlock Text="·" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource MetaSep}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DueDate"/>
                                    <Binding Path="Reminder"/>
                                    <Binding Path="Note"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <MultiBinding.ConverterParameter>2</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- Due date: 📅 + text -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="DueDate"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{Binding DueDate, Converter={StaticResource DueDateToBrush}}"/>
                            <TextBlock Text="{Binding DueDate, Converter={StaticResource DueDateToString}}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{Binding DueDate, Converter={StaticResource DueDateToBrush}}"/>
                        </StackPanel>
                        <!-- · due date → reminder -->
                        <TextBlock Text="·" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource MetaSep}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DueDate"/>
                                    <Binding Path="Reminder"/>
                                    <Binding Path="Note"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <MultiBinding.ConverterParameter>3</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- Reminder: 🔔 + text -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="Reminder"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <MultiBinding.ConverterParameter>future</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                       Foreground="{DynamicResource TaskMetaBrush}"/>
                            <TextBlock Text="{Binding Reminder, Converter={StaticResource ReminderToString}}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TaskMetaBrush}"/>
                        </StackPanel>
                        <!-- · reminder → note -->
                        <TextBlock Text="·" FontSize="13" Margin="5,0,5,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource MetaSep}">
                                    <Binding Path="TagIds"/>
                                    <Binding Path="Steps.Count"/>
                                    <Binding Path="DueDate"/>
                                    <Binding Path="Reminder"/>
                                    <Binding Path="Note"/>
                                    <Binding Path="DataContext.ShowTaskTags" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskSteps" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskDue" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskReminder" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    <MultiBinding.ConverterParameter>4</MultiBinding.ConverterParameter>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <!-- Note icon: single icon, content only in the tooltip -->
                        <TextBlock Text="&#xE932;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TaskMetaBrush}"
                                   ToolTip="{Binding Note}">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource ItemAndSettingVis}">
                                    <Binding Path="Note"/>
                                    <Binding Path="DataContext.ShowTaskNote" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
                <!-- Right icons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Star_Click" Width="24" Height="24">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE734;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                            <Setter Property="Text" Value="&#xE735;"/>
                                            <Setter Property="Foreground" Value="#FFD335"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Task row wrapper with drag-drop + context menu -->
        <DataTemplate x:Key="TaskRowReorder">
            <Border Style="{StaticResource TaskRowStyle}"
                    PreviewMouseLeftButtonDown="RecordDragStart"
                    MouseLeftButtonDown="TaskRow_Click"
                    MouseMove="TaskRow_MouseMove"
                    ContextMenuOpening="TaskRow_ContextMenuOpening"
                    AllowDrop="True" DragEnter="TaskRow_DragEnter"
                    DragOver="TaskRow_DragOver"
                    DragLeave="TaskRow_DragLeave" Drop="TaskRow_Drop">
                <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskRowContent}"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- ═══ MAIN 3-COLUMN LAYOUT ═══ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" MinWidth="180" MaxWidth="480"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ SIDEBAR (Column 0) ═══════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="14,14,14,0">
                    <!-- Search box -->
                    <Grid Height="32" Margin="0,0,0,2">
                        <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchTextBox}" Padding="12,0,28,0"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="{x:Static services:Loc.Search}" FontSize="13"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
                        <!-- X clear button -->
                        <Button Content="&#xE10A;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource FluentSubtleButton}" FontSize="10"
                                Width="22" Height="22" Padding="0"
                                Foreground="{DynamicResource TextDisabledBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                Click="SearchClear_Click"
                                Visibility="Collapsed" x:Name="SearchClearBtn"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,4"/>
                </StackPanel>

                <!-- Scrollable area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- System Lists -->
                        <ListBox ItemsSource="{Binding SystemLists}"
                                 SelectedValue="{Binding ActiveListId}"
                                 SelectedValuePath="Id"
                                 BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource SidebarNavItem}" Margin="0,4,0,4"
                                 DragEnter="SidebarList_DragEnter" DragOver="SidebarList_DragOver" DragLeave="SidebarList_DragLeave"
                                 Drop="SidebarList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TaskList}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" FontFamily="Segoe UI Emoji"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MouseLeftButtonDown="SidebarListName_DoubleClick"
                                                   Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"/>
                                        <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="14" VerticalAlignment="Center"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource FluentInlineEditBox}"
                                                 KeyDown="SidebarRename_KeyDown"
                                                 LostFocus="SidebarRename_LostFocus"
                                                 IsVisibleChanged="SidebarRename_IsVisibleChanged"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TaskCount}" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" FontSize="12"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   Visibility="{Binding TaskCount, Converter={StaticResource CountToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Divider -->
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="14,4"/>

                        <!-- Custom List Groups -->
                        <ItemsControl ItemsSource="{Binding GroupedCustomLists}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ListGroupDisplay}">
                                    <StackPanel>
                                        <Border Margin="4,2" Padding="14,6" CornerRadius="6" Background="Transparent" Cursor="Hand"
                                                PreviewMouseLeftButtonDown="RecordDragStart"
                                                PreviewMouseMove="ListGroupHeader_PreviewMouseMove"
                                                MouseLeftButtonUp="ListGroupHeader_Click"
                                                ContextMenuOpening="ListGroup_ContextMenuOpening"
                                                AllowDrop="True" DragEnter="ListGroupHeader_DragEnter" DragOver="ListGroupHeader_DragOver"
                                                DragLeave="ListGroupHeader_DragLeave" Drop="ListGroupHeader_Drop">
                                            <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE70D;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Group.Collapsed}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE76C;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Group.Name}" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"
                                                           Tag="ListGroupName"
                                                           MouseLeftButtonDown="ListGroupName_DoubleClick"/>
                                                <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                         Style="{StaticResource FluentInlineEditBox}"
                                                         KeyDown="ListGroupName_KeyDown"
                                                         LostFocus="ListGroupName_LostFocus"/>
                                            </Grid>
                                        </Border>
                                        <ListBox ItemsSource="{Binding Lists}" PreviewMouseLeftButtonDown="RecordDragStart"
                                                 PreviewMouseMove="SidebarList_PreviewMouseMove"
                                                 SelectedValue="{Binding DataContext.ActiveListId, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 SelectedValuePath="Id" BorderThickness="0" Background="Transparent"
                                                 ItemContainerStyle="{StaticResource SidebarNavItem}"
                                                 Visibility="{Binding TaskListVisible, Converter={StaticResource BoolToVis}}"
                                                 Margin="16,0,0,0"
                                                 DragEnter="SidebarList_DragEnter" DragOver="SidebarList_DragOver" DragLeave="SidebarList_DragLeave"
                                                 Drop="SidebarList_Drop">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:TaskList}">
                                                    <Grid ContextMenuOpening="SidebarGrid_ContextMenuOpening"><Grid.ContextMenu><ContextMenu Loaded="SidebarGrid_MenuLoaded"/></Grid.ContextMenu>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" FontFamily="Segoe UI Emoji"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center"
                                                                   MouseLeftButtonDown="SidebarListName_DoubleClick"
                                                                   Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"/>
                                                        <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="14" VerticalAlignment="Center"
                                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                                                 Style="{StaticResource FluentInlineEditBox}"
                                                                 KeyDown="SidebarRename_KeyDown"
                                                                 LostFocus="SidebarRename_LostFocus"
                                                                 IsVisibleChanged="SidebarRename_IsVisibleChanged"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding TaskCount}" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding TaskCount, Converter={StaticResource CountToVis}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Ungrouped -->
                        <ListBox ItemsSource="{Binding UngroupedCustomLists}"
                                 PreviewMouseLeftButtonDown="RecordDragStart"
                                 PreviewMouseMove="SidebarList_PreviewMouseMove"
                                 SelectedValue="{Binding ActiveListId}"
                                 SelectedValuePath="Id"
                                 BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource SidebarNavItem}" Margin="0,0,0,4"
                                 DragEnter="SidebarList_DragEnter" DragOver="SidebarList_DragOver" DragLeave="SidebarList_DragLeave"
                                 Drop="SidebarList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TaskList}">
                                    <Grid ContextMenuOpening="SidebarGrid_ContextMenuOpening"><Grid.ContextMenu><ContextMenu Loaded="SidebarGrid_MenuLoaded"/></Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" FontFamily="Segoe UI Emoji"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="">
                                                            <Setter Property="Text" Value="📋"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="14"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MouseLeftButtonDown="SidebarListName_DoubleClick"
                                                   Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}"/>
                                        <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="14" VerticalAlignment="Center"
                                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                                                 Style="{StaticResource FluentInlineEditBox}"
                                                 KeyDown="SidebarRename_KeyDown"
                                                 LostFocus="SidebarRename_LostFocus"
                                                 IsVisibleChanged="SidebarRename_IsVisibleChanged"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TaskCount}" VerticalAlignment="Center"
                                                   Margin="8,0,0,0" FontSize="12"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   Visibility="{Binding TaskCount, Converter={StaticResource CountToVis}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- New list input (between scroll and footer) -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                        Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource FluentSubtleButton}"
                                FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                                Click="NewList_Click" Padding="6,3" Margin="0,0,4,0"
                                HorizontalContentAlignment="Left">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="18" Margin="0,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Static services:Loc.NewListText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                        <Button Grid.Column="1" Content="&#xED0E;" FontFamily="Segoe Fluent Icons"
                                Style="{StaticResource FluentSubtleButton}" FontSize="18"
                                Width="36" Height="36" Padding="0"
                                Click="NewListGroup_Click" Foreground="{DynamicResource TextSecondaryBrush}"
                                ToolTip="{x:Static services:Loc.NewListGroup}"/>
                    </Grid>
                </Border>

                <!-- Footer: settings gear + sync status dot on the right (hover for details) -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource FluentSubtleButton}" FontSize="16"
                                    Width="28" Height="24" Padding="0"
                                    Command="{Binding OpenSettingsCommand}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    AutomationProperties.AutomationId="OpenSettings"
                                    AutomationProperties.Name="{x:Static services:Loc.Settings}"
                                    ToolTip="{x:Static services:Loc.Settings}"/>
                            <Button Content="&#xE70B;" FontFamily="Segoe Fluent Icons"
                                    Style="{StaticResource FluentSubtleButton}" FontSize="16"
                                    Width="28" Height="24" Padding="0" Margin="4,0,0,0"
                                    Click="StickyNote_Click"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    AutomationProperties.AutomationId="StickyNote"
                                    AutomationProperties.Name="{x:Static services:Loc.StickyNote}"
                                    ToolTip="{x:Static services:Loc.StickyNote}"/>
                        </StackPanel>
                        <!-- Sync indicator: hand-drawn two-arrow sync glyph. Segoe MDL2's
                             E895 is a hairline monoline glyph that can't be thickened, so
                             this Path draws the same two chasing circular arrows with a
                             thick stroke (2/16 units ≈ 2x the MDL2 stroke) at the same
                             on-screen size. Colored by state, spins while a round-trip is
                             in flight. Click = sync now; hover shows the full status text. -->
                        <Button Grid.Column="1" Style="{StaticResource FluentSubtleButton}"
                                Command="{Binding SyncNowCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="10,4" Cursor="Hand"
                                ToolTip="{Binding SyncStatusText}"
                                AutomationProperties.AutomationId="SyncStatus"
                                AutomationProperties.Name="{x:Static services:Loc.SyncNow}">
                            <Viewbox Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                <Grid Width="16" Height="16">
                                    <Path Stroke="{Binding SyncStatusBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M 14.01,10.49 A 6.5,6.5 0 0 1 1.99,10.49
                                                M 1.99,5.51 A 6.5,6.5 0 0 1 14.01,5.51
                                                M 1.99,10.49 L 1.77,12.96
                                                M 1.99,10.49 L 3.9,12.08
                                                M 14.01,5.51 L 14.23,3.04
                                                M 14.01,5.51 L 12.1,3.92"/>
                                </Grid>
                                <Viewbox.RenderTransform>
                                    <RotateTransform/>
                                </Viewbox.RenderTransform>
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SyncIsSyncing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SyncSpinStoryboard">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="SyncSpinStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- GridSplitter: resize the sidebar, width persisted via SidebarWidth -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ShowsPreview="True"/>

        <!-- ═══════════════ MAIN CONTENT (Column 2) ═══════════════ -->
        <Grid Grid.Column="2" Visibility="{Binding IsSettingsMode, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- List header -->
            <Border Grid.Row="0" Padding="24,20,24,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Header icon: emoji (list) or search icon, clickable for custom lists -->
                        <Button x:Name="EmojiBtn" Cursor="Hand" Click="ListEmoji_Click"
                                VerticalAlignment="Center" Margin="0,-2,12,0">
                            <Button.Template>
                                <!-- Left-align the emoji like the system-list icon; the button
                                     sizes to its content so there is no centering gap -->
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FluentSubtleButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- Only show for custom lists and not searching -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCustomList}" Value="True"/>
                                                <Condition Binding="{Binding IsSearching}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Content>
                                <TextBlock Text="{Binding ActiveList.Icon}" FontSize="26"
                                           FontFamily="Segoe UI Emoji"/>
                            </Button.Content>
                        </Button>
                        <!-- Read-only icon: system list or searching -->
                        <TextBlock VerticalAlignment="Center" Margin="0,-2,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <!-- Searching → show search icon -->
                                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="&#xE721;"/>
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                            <Setter Property="FontSize" Value="22"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
                                        </DataTrigger>
                                        <!-- System list, not searching → show emoji -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSystemList}" Value="True"/>
                                                <Condition Binding="{Binding IsSearching}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="{Binding ActiveList.Icon}"/>
                                            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
                                            <Setter Property="FontSize" Value="26"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Editable title (click to rename) -->
                        <TextBlock x:Name="ListTitleLabel" Text="{Binding HeaderTitle}" FontSize="28"
                                   FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Cursor="Hand"
                                   MouseLeftButtonDown="ListTitle_Click"/>
                        <TextBox x:Name="ListTitleEdit" FontSize="28" FontWeight="Bold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 VerticalAlignment="Center" Visibility="Collapsed"
                                 Style="{StaticResource FluentInlineEditBox}" MinWidth="100"
                                 KeyDown="ListTitleEdit_KeyDown"
                                 LostFocus="ListTitleEdit_LostFocus"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="NewGroupBtn" Content="{x:Static services:Loc.NewGroup}"
                                FontSize="13" Click="NewGroup_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FluentSubtleButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                Style="{StaticResource FluentSubtleButton}" FontSize="16"
                                Foreground="{DynamicResource TextSecondaryBrush}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static services:Loc.RenameList}" Click="ListMenu_Rename"/>
                                    <MenuItem Header="{x:Static services:Loc.DeleteList}" Click="ListMenu_Delete"
                                              Visibility="{Binding ActiveList.IsSystem, Converter={StaticResource InverseBoolToVis}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Task area -->
            <ScrollViewer x:Name="TaskAreaScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,15,0,8"
                          AllowDrop="True" PreviewDragOver="TaskArea_PreviewDragOver"
                          ScrollChanged="TaskAreaScroll_ScrollChanged">
                <StackPanel x:Name="TaskAreaPanel">
                    <!-- ═══ CUSTOM LIST: Groups (first entry = ungrouped tasks) ═══ -->
                    <ItemsControl x:Name="GroupedTasksControl" ItemsSource="{Binding GroupedTaskList}"
                                  Visibility="{Binding IsCustomList, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GroupedTasks}">
                                <!-- Wrapper border: drop target for entire section -->
                                <Border AllowDrop="True"
                                        DragEnter="GroupSection_DragEnter"
                                        DragLeave="GroupSection_DragLeave"
                                        Drop="GroupSection_Drop"
                                        Padding="0" Background="Transparent" CornerRadius="6">
                                <StackPanel>
                                    <!-- Group header (only for real groups). Tag anchors the
                                         visual-tree search that locates the "ungrouped zone"
                                         boundary for the drop slot (FindUngroupedZoneBottom). -->
                                    <Border Style="{StaticResource GroupHeaderStyle}" Cursor="Hand"
                                            Tag="TaskGroupHeader"
                                            Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}"
                                            PreviewMouseLeftButtonDown="RecordDragStart"
                                            PreviewMouseMove="GroupHeader_PreviewMouseMove"
                                            MouseLeftButtonUp="GroupHeader_Toggle"
                                            ContextMenuOpening="GroupHeader_ContextMenuOpening"
                                            AllowDrop="True" DragEnter="GroupHeader_DragEnter"
                                            DragOver="GroupHeader_DragOver"
                                            DragLeave="GroupHeader_DragLeave" Drop="GroupHeader_Drop">
                                        <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE70D;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Group.Collapsed}" Value="True">
                                                                <Setter Property="Text" Value="&#xE76C;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Group name with the task count inline, e.g. "工作 (5)" -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="{Binding Group.Name}" FontSize="15"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Tag="GroupName"
                                                           MouseLeftButtonDown="GroupName_DoubleClick"/>
                                                <TextBlock Text="{Binding Tasks.Count, StringFormat='({0})'}"
                                                           FontSize="13" VerticalAlignment="Center"
                                                           Margin="6,1,0,0"
                                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="15" FontWeight="SemiBold"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                     Style="{StaticResource FluentInlineEditBox}"
                                                     KeyDown="GroupNameEdit_KeyDown"
                                                     LostFocus="GroupNameEdit_LostFocus"/>
                                        </Grid>
                                    </Border>
                                    <!-- Tasks (hidden if collapsed; always show for ungrouped) -->
                                    <ItemsControl ItemsSource="{Binding Tasks}"
                                                  Visibility="{Binding TaskListVisible, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:TaskItem}">
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskRowReorder}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Empty ungrouped section: zero height with no tasks, so
                                         while a task drag nears the top of the list this slot
                                         expands to accept a grouped task dragged back to ungrouped
                                         (drops bubble to GroupSection_Drop). It only appears when
                                         the pointer is in the top zone (above the first group's
                                         mid) and slides/fades in rather than popping. Height,
                                         Opacity and Margin are animated from code-behind
                                         (MainWindow.SetDropSlotOpen) — a Style trigger's
                                         EnterActions storyboard is not reverted when the trigger
                                         deactivates, leaving the slot stuck open. The Tag anchors
                                         that visual-tree lookup; the base setters are the closed
                                         state. -->
                                    <Border Tag="UngroupDropSlot" Padding="12,8" CornerRadius="8"
                                            ClipToBounds="True"
                                            BorderBrush="{DynamicResource NeutralGray110}"
                                            BorderThickness="1" Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Height" Value="0"/>
                                                <Setter Property="Opacity" Value="0"/>
                                                <Setter Property="Margin" Value="32,0"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{x:Static services:Loc.DropToUngroupHint}"
                                                   FontSize="13" Foreground="{DynamicResource TextDisabledBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                            </StackPanel>
                                </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                    <!-- ═══ SYSTEM LIST: Flat task list ═══ -->
                    <ItemsControl ItemsSource="{Binding ActiveTasks}"
                                  Visibility="{Binding IsSystemList, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TaskItem}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TaskRowReorder}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Completed tasks (collapsible; expanded by default) -->
                    <Border Visibility="{Binding CompletedTasks.Count, Converter={StaticResource CountToVis}}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                            Margin="0,16,0,0" Padding="0,12,0,0">
                        <StackPanel>
                            <ToggleButton x:Name="CompletedToggle" IsChecked="True"
                                          Focusable="False" Cursor="Hand" HorizontalAlignment="Stretch"
                                          Margin="0,0,0,8">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="Chevron" Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Margin="0,0,6,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CompletedHeader}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background"
                                                        Value="{DynamicResource CardHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ItemsControl ItemsSource="{Binding CompletedTasks}"
                                          Visibility="{Binding IsChecked, ElementName=CompletedToggle,
                                                               Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TaskItem}">
                                        <Border Style="{StaticResource TaskRowStyle}" Opacity="0.7"
                                                MouseLeftButtonDown="TaskRow_Click"
                                                ContextMenuOpening="TaskRow_ContextMenuOpening">
                                            <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource TaskRowContent}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Fixed Add Task Input at bottom -->
            <Border x:Name="AddTaskFooter" Grid.Row="2" Padding="32,8,32,12"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource AppBackgroundBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBox x:Name="AddTaskBox"
                             Style="{StaticResource FluentTextBox}"
                             FontSize="15" Height="47" VerticalContentAlignment="Center"
                             Padding="43,4,6,4"
                             KeyDown="AddTaskBox_KeyDown"
                             GotFocus="AddTaskBox_GotFocus"
                             LostFocus="AddTaskBox_LostFocus"
                             TextChanged="AddTaskBox_TextChanged"/>
                    <!-- Empty checkbox (same look/position as task rows), shown while the box has focus -->
                    <Border x:Name="AddTaskCheckbox" Width="22" Height="22"
                            Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="Transparent" BorderBrush="{DynamicResource NeutralGray110}"
                            BorderThickness="1.5" CornerRadius="4"
                            IsHitTestVisible="False" Visibility="Collapsed"/>
                    <!-- Placeholder "+ 添加任务": only when empty and not focused. "+" sits in the
                         checkbox slot, text starts where typed text lands -->
                    <Grid x:Name="AddTaskPlaceholder" IsHitTestVisible="False"
                          VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="+" FontSize="22" FontWeight="Light"
                                   Foreground="{DynamicResource TextAccentBrush}"
                                   Width="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{x:Static services:Loc.AddTask}" FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════ SETTINGS PAGE (Column 2 overlay) ═══════════════ -->
        <Grid Grid.Column="2" Visibility="{Binding IsSettingsMode, Converter={StaticResource BoolToVis}}"
              AutomationProperties.AutomationId="SettingsHost">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="20,12,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource FluentSubtleButton}" FontSize="18"
                        Padding="8,6" Command="{Binding CloseSettingsCommand}"
                        AutomationProperties.AutomationId="CloseSettings"
                        AutomationProperties.Name="{x:Static services:Loc.Back}"
                        ToolTip="{x:Static services:Loc.Back}"
                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Static services:Loc.Settings}" FontSize="22"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
            <views:SettingsPage Grid.Row="1" DataContext="{Binding Settings}"/>
        </Grid>

        <!-- ═══════════════ TASK DETAIL PANE (Column 2) ═══════════════ -->
        <Border Grid.Column="3" Width="360" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding SelectedTask, Converter={StaticResource NullToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="20,16" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="{x:Static services:Loc.TaskDetails}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button Content="&#xE89F;" FontFamily="Segoe Fluent Icons"
                                Style="{StaticResource FluentSubtleButton}" FontSize="14"
                                HorizontalAlignment="Right"
                                Click="DetailPane_Close"/>
                    </Grid>
                </Border>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16">
                        <TextBox x:Name="DetailTitleBox"
                                 Text="{Binding SelectedTask.Title, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource FluentTextBox}" FontSize="18"
                                 FontWeight="SemiBold" BorderThickness="0,0,0,1"
                                 Margin="0,0,0,16"
                                 GotFocus="DetailField_GotFocus"
                                 LostFocus="DetailField_LostFocus"/>

                        <!-- Due Date -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Date}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Button x:Name="DueDateBtn"
                                            Style="{StaticResource FluentSubtleButton}"
                                            FontSize="13" Padding="8,4" HorizontalAlignment="Left"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Click="DueDateBtn_Click">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DueDateLabel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button Content="✕" Style="{StaticResource FluentSubtleButton}"
                                            FontSize="12" Width="24" Height="24" Padding="0"
                                            Foreground="{DynamicResource TextDisabledBrush}"
                                            HorizontalAlignment="Right"
                                            Click="DetailDueDate_Clear"
                                            Visibility="{Binding SelectedTask.DueDate, Converter={StaticResource NullToVis}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- My Day toggle -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Foreground="{DynamicResource TextAccentBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{x:Static services:Loc.MyDay}" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource FluentCheckBox}"
                                          IsChecked="{Binding SelectedTask.IsMyDay, Mode=OneWay}"
                                          Click="MyDayToggle_Click"/>
                            </Grid>
                        </Border>

                        <!-- Reminder -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Reminder}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Button x:Name="ReminderBtn"
                                            Style="{StaticResource FluentSubtleButton}"
                                            FontSize="13" Padding="8,4" HorizontalAlignment="Left"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Click="ReminderBtn_Click">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ReminderLabel" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                    <Button Content="✕" Style="{StaticResource FluentSubtleButton}"
                                            FontSize="12" Width="24" Height="24" Padding="0"
                                            Foreground="{DynamicResource TextDisabledBrush}"
                                            HorizontalAlignment="Right"
                                            Click="ReminderClear_Click"
                                            Visibility="{Binding SelectedTask.Reminder, Converter={StaticResource NullToVis}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Steps -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Steps}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SelectedTask.Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:TaskStep}">
                                            <Border Margin="0,2" AllowDrop="True"
                                                    DragEnter="StepRow_DragEnter"
                                                    DragOver="StepRow_DragOver"
                                                    DragLeave="StepRow_DragLeave"
                                                    Drop="StepRow_Drop">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Style="{StaticResource FluentCheckBox}"
                                                          IsChecked="{Binding Completed}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"
                                                          Checked="StepToggle_Changed"
                                                          Unchecked="StepToggle_Changed"/>
                                                <Button Grid.Column="1" HorizontalAlignment="Left"
                                                        Style="{StaticResource FluentSubtleButton}"
                                                        FontSize="13" Padding="0"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}"
                                                        Click="StepTitle_Click">
                                                    <Button.Content>
                                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button.Content>
                                                </Button>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13" VerticalAlignment="Center"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                         Style="{StaticResource FluentInlineEditBox}"
                                                         KeyDown="StepEdit_KeyDown"
                                                         LostFocus="StepEdit_LostFocus"/>
                                                <Button Grid.Column="2" Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                                                        Style="{StaticResource FluentSubtleButton}" FontSize="14"
                                                        Width="24" Height="24" Padding="0" Cursor="SizeAll"
                                                        Foreground="{DynamicResource TextDisabledBrush}"
                                                        PreviewMouseLeftButtonDown="RecordDragStart"
                                                        MouseMove="StepHandle_MouseMove"
                                                        Click="StepHandle_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="+" FontSize="16"
                                            Style="{StaticResource FluentSubtleButton}"
                                            Foreground="{DynamicResource TextAccentBrush}"
                                            Width="24" Height="28" Padding="0"
                                            VerticalAlignment="Center" Margin="0,0,4,0"
                                            Click="AddStepBox_ButtonClick"/>
                                    <TextBox x:Name="AddStepBox" Grid.Column="1"
                                             Style="{StaticResource FluentTextBox}" FontSize="12"
                                             KeyDown="AddStepBox_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tags Section -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static services:Loc.Tags}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+"
                                            Style="{StaticResource FluentSubtleButton}" FontSize="16"
                                            Width="28" Height="24" Padding="0"
                                            Foreground="{DynamicResource TextAccentBrush}"
                                            Click="DetailAddTag_Click"/>
                                </Grid>
                                <ItemsControl x:Name="DetailTagList" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:Tag}">
                                            <Border Padding="6,3" Margin="0,0,4,4" CornerRadius="10"
                                                    Cursor="Hand"
                                                    Background="{Binding Color, Converter={StaticResource StringToAlphaBrush}}"
                                                    MouseLeftButtonDown="DetailTag_Remove">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"/>
                                                    <TextBlock Text=" ×" FontSize="12"
                                                               Foreground="{Binding Color, Converter={StaticResource StringToBrush}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Group Section (only for custom lists) -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding DataContext.IsCustomList, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock x:Name="DetailGroupLabel" FontSize="11" FontWeight="SemiBold"
                                           Text="{x:Static services:Loc.Group}"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="DetailGroupBox" FontSize="13"
                                          Style="{StaticResource FluentComboBox}"
                                          SelectionChanged="DetailGroup_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComboDisplay}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- Close Info -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16"
                                Visibility="{Binding SelectedTask.CloseRecord, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Closed}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               Text="{Binding SelectedTask.CloseRecord.CloseMode, Converter={StaticResource CloseModeToIcon}}"
                                               Foreground="{Binding SelectedTask.CloseRecord.CloseMode, Converter={StaticResource CloseModeToBrush}}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Text="{Binding SelectedTask.CloseModeDisplay}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedTask.CloseRecord.ClosedAt, Converter={StaticResource TimestampToRelative}}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <Button Content="{x:Static services:Loc.EditCloseTime}"
                                        Style="{StaticResource FluentSubtleButton}" FontSize="12"
                                        HorizontalAlignment="Left" Foreground="{DynamicResource TextAccentBrush}"
                                        Click="DetailPane_EditCloseTime"/>
                            </StackPanel>
                        </Border>

                        <!-- Notes -->
                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{x:Static services:Loc.Notes}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" Margin="0,0,0,8"/>
                                <TextBox x:Name="DetailNoteBox"
                                         Text="{Binding SelectedTask.Note, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource FluentTextBox}" MinHeight="80"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         GotFocus="DetailField_GotFocus"
                                         LostFocus="DetailField_LostFocus"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Padding="20,12" BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   Text="{Binding SelectedTask.CreatedAt, Converter={StaticResource TimestampToRelative}}"
                                   HorizontalAlignment="Left"/>
                        <Button Content="{x:Static services:Loc.Delete}" Style="{StaticResource FluentSubtleButton}"
                                FontSize="13" Foreground="{DynamicResource AccentRedBrush}"
                                HorizontalAlignment="Right"
                                Click="DetailPane_Delete"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
