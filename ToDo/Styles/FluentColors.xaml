<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent Design Brushes — use SolidColorBrush everywhere to avoid locale-specific Color→Brush conversion -->
    <SolidColorBrush x:Key="NeutralWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NeutralGray10" Color="#FAF9F8"/>
    <SolidColorBrush x:Key="NeutralGray20" Color="#F3F2F1"/>
    <SolidColorBrush x:Key="NeutralGray30" Color="#EDEBE9"/>
    <SolidColorBrush x:Key="NeutralGray40" Color="#E1DFDD"/>
    <SolidColorBrush x:Key="NeutralGray50" Color="#D2D0CE"/>
    <SolidColorBrush x:Key="NeutralGray60" Color="#C8C6C4"/>
    <SolidColorBrush x:Key="NeutralGray90" Color="#A19F9D"/>
    <SolidColorBrush x:Key="NeutralGray110" Color="#8A8886"/>
    <SolidColorBrush x:Key="NeutralGray130" Color="#605E5C"/>
    <SolidColorBrush x:Key="NeutralGray150" Color="#3B3A39"/>
    <SolidColorBrush x:Key="NeutralGray160" Color="#323130"/>
    <SolidColorBrush x:Key="NeutralGray190" Color="#201F1E"/>

    <SolidColorBrush x:Key="AccentBlue" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentBlueLight" Color="#E6F2FC"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#107C10"/>
    <SolidColorBrush x:Key="AccentRed" Color="#C42B1C"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#FF8C00"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#FCE100"/>

    <!-- Semantic brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F2F1"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FAF9F8"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E1DFDD"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F3F2F1"/>
    <SolidColorBrush x:Key="CardSelectedBrush" Color="#E6F2FC"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#201F1E"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#605E5C"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A19F9D"/>
    <SolidColorBrush x:Key="TextAccentBrush" Color="#0078D4"/>

    <SolidColorBrush x:Key="BorderLightBrush" Color="#E1DFDD"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#EDEBE9"/>

    <SolidColorBrush x:Key="AccentRedBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#107C10"/>

    <!-- Font -->
    <FontFamily x:Key="FluentFont">Microsoft YaHei UI</FontFamily>

</ResourceDictionary>
